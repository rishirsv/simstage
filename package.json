{
  "name": "sim-stage",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Local Sim Stage MCP app for ChatGPT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "bun x --bun tsc --noEmit",
    "test": "bun test",
    "start": "bun packages/sim-stage-mcp/dist/server.js",
    "dev": "bun src/server.ts",
    "preview": "bun packages/sim-stage-mcp/dist/server.js --preview",
    "pack": "bun scripts/pack.mjs",
    "verify:packages": "bun scripts/verify-packages.mjs",
    "dev:plugin": "bun scripts/dev-plugin.mjs",
    "version": "bun scripts/sync-version.mjs && git add packages/sim-stage-mcp/package.json plugins/sim-stage/plugin.json plugins/sim-stage/.codex-plugin/plugin.json plugins/sim-stage/.mcp.json plugins/sim-stage/mcp.json",
    "benchmark:browser": "bun scripts/browser-benchmark.mjs",
    "assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/mcp-extensions": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "license": "MIT"
}
